# Copy this file to `.env` and populate it with real values for your local
# environment. Never commit the populated `.env` file (see .gitignore,
# docs/RISK_REGISTER.md RR-001).

# --- MetaTrader 5 broker connection (broker/, ADR-0002) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Economic calendar provider (news/) ---
ECONOMIC_CALENDAR_API_KEY=

# --- Calendar provider chain (news/calendar_provider.py, optional) ---
# Comma-separated provider names tried in order, falling back to the next on
# any failure (network fault, timeout, or exhausted rate limit). Defaults to
# just `offline_snapshot` (no external config needed) if unset. Set this to
# e.g. `tradingeconomics,finnhub,offline_snapshot` to enable the network
# providers — doing so requires the matching CALENDAR_<PROVIDER>_BASE_URL
# below (no default is guessed; boot fails fast if missing).
# CALENDAR_PROVIDER_PRIORITY=offline_snapshot
# CALENDAR_TIMEOUT_MS=3000
# CALENDAR_RATE_LIMIT_PER_MIN=60
# CALENDAR_TRADINGECONOMICS_BASE_URL=
# CALENDAR_FINNHUB_BASE_URL=
# CALENDAR_OFFLINE_SNAPSHOT_PATH=news/offline_calendar_snapshot.json

# --- Feature flags (config/feature_flags.py, optional) ---
# Governs HARD_LOCK's behavior in the drawdown FSM (risk/drawdown_fsm.py,
# docs/PRODUCTION_SPEC.md §6): true triggers an immediate emergency market
# liquidation of any open position; false (the default — the safer,
# capital-preserving choice) freezes all operations until an explicit
# human reset. One of: true/false/1/0/yes/no/on/off (case-insensitive).
# FLAG_LIQUIDATE_ON_HARD_LOCK=false

# --- Strategy identification ---
# Unique integer identifying this bot's orders to the broker terminal, used to
# distinguish this strategy's positions from any other EA/manual trading on
# the same account.
STRATEGY_MAGIC_NUMBER=

# --- Runtime environment mode ---
# One of: DEMO, LIVE. Gates which MT5 account class the system is permitted to
# trade against at startup (docs/RISK_REGISTER.md RR-012).
ENVIRONMENT_MODE=DEMO
